# SPDX-License-Identifier: MIT
# geforce-sriov @VERSION@: bring the VFs and their vGPU types up once per boot.
# Runs after the prepare unit and after NVIDIA's two daemons are up, and before
# VM autostart, so that every selected GPU has its VFs, its vGPU type and
# power/control=on before any guest starts. `activate --boot` first waits up to
# 30 s for each selected PF to bind to nvidia, then loads nvidia_vgpu_vfio,
# restarts nvidia-vgpud and nvidia-vgpu-mgr in order, re-probes each PF, sets the
# type on every VF and powers it, and prints what `check` prints.
#
# It does not run on the boot-display path: with boot_display_release= in the
# config, prepare --boot defers and writes /run/geforce-sriov/deferred, and
# ConditionPathExists=! on that file makes systemd skip this unit (activate
# never starts). The cards are then brought up by hand.
#
# One-boot escape hatch: add `geforce_sriov.skip` to the kernel command line.
# The unit is enabled by `geforce-sriov install --device BDF` only; installing
# never starts it.
[Unit]
Description=geforce-sriov: bring up the VFs and vGPU types of the selected GeForce GPUs
After=geforce-sriov-prepare.service nvidia-vgpud.service nvidia-vgpu-mgr.service
# Before VM autostart, named generically so one hypervisor is not assumed.
Before=libvirt-guests.service pve-guests.service
ConditionPathExists=/etc/geforce-sriov/config
ConditionPathExists=!/run/geforce-sriov/deferred
ConditionKernelCommandLine=!geforce_sriov.skip
RequiresMountsFor=/var/lib/geforce-sriov @BINDIR@

[Service]
Type=oneshot
ExecStart=@BINDIR@/geforce-sriov activate --boot
RemainAfterExit=yes
# 600 s covers the 30 s bind wait of up to eight selected cards (240 s, the
# most a config lists) and leaves the rest for the bring-up, whose later steps
# each wait up to 15 s per card or per VF; it is not the sum of every wait.
TimeoutStartSec=600
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
