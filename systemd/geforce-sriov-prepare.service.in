# SPDX-License-Identifier: MIT
# geforce-sriov @VERSION@: present SR-IOV on the GPUs selected in /etc/geforce-sriov/config.
# Runs once per boot, before udevd starts (the kernel's uevents wait in
# systemd-udevd-kernel.socket) and before any NVIDIA service, so that no
# modalias load can bind a selected physical function while the
# geforce_sriov livepatch is loaded and each card is removed and rescanned.
# `geforce-sriov prepare` refuses (and changes nothing) when a selected PF is
# already bound, is the boot display, shares its bus, has active VFs, or when
# the guard of an unfinished earlier attempt is set; a guard left by an unfinished
# attempt makes every later boot an ordinary one until it is cleared after a power cycle.
#
# With boot_display_release= in the config, `prepare --boot` defers: it changes
# nothing on any card, records /run/geforce-sriov/deferred (which holds
# nvidia-vgpud back) and exits 0. The selection is then prepared by hand after
# boot with `geforce-sriov prepare --release-console=BDF`.
#
# One-boot escape hatch: add `geforce_sriov.skip` to the kernel command line.
# The unit is enabled by `geforce-sriov install --device BDF` only; installing
# never starts it.
[Unit]
Description=geforce-sriov: present SR-IOV on the selected GeForce GPUs
DefaultDependencies=no
After=systemd-remount-fs.service systemd-journald.socket
Before=systemd-udevd.service systemd-udev-trigger.service systemd-modules-load.service sysinit.target shutdown.target
Before=nvidia-persistenced.service nvidia-vgpud.service nvidia-vgpu-mgr.service
Conflicts=shutdown.target
# /var/lib and the binary's directory should be on the root filesystem or a volume the
# initramfs activates: this unit runs before udevd, so it cannot wait for devices udev has
# not yet processed.
RequiresMountsFor=/var/lib/geforce-sriov @BINDIR@
ConditionPathExists=/etc/geforce-sriov/config
ConditionKernelCommandLine=!geforce_sriov.skip

[Service]
Type=oneshot
ExecStart=@BINDIR@/geforce-sriov prepare --boot
RemainAfterExit=yes
TimeoutStartSec=120
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=sysinit.target
